$TTL 86400
$ORIGIN in-addr.arpa.
@   IN  SOA ns.root. hostmaster.root. (
        2026081501 ; serial
        3600       ; refresh
        1800       ; retry
        604800     ; expire
        86400 )    ; minimum
    IN  NS  ns.root.

; Delegation of 0.20.10.in-addr.arpa.
0.20.10         IN  NS  ns100.lab.test.
